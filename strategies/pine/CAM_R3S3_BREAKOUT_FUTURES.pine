//@version=6
// =============================================================================
// CAM_BREAKOUT_R3S3_FUT — futures build (ES / NQ / MES / MNQ)
// =============================================================================
// A faithful port of the production CAM_BREAKOUT_R3S3 equity script. Entry
// logic, exit mechanism, previous-RTH capture and alert payload are the SAME
// rules — anything that differs below is a futures necessity and is commented
// as such, so a live-vs-equity comparison measures the market and not a config
// drift between two scripts.
//
// DELTAS FROM THE EQUITY SCRIPT — and only these:
//   1. margin_long / margin_short. TradingView defaults margin to 100% (the
//      full notional in cash). MNQ at ~30,650 is $61,300 notional PER CONTRACT
//      and ES is ~$335,000, so on any real balance every entry is silently
//      rejected and the Strategy Tester reports "requires trade data".
//   2. Commission. Alpaca equities are commission-free so the equity script
//      needs none; futures are ~$2-5 round turn and that is material on the
//      stop distances this strategy uses.
//   3. Risk defaults in POINTS, scaled per contract. The mechanism is
//      unchanged (price distance -> ticks via syminfo.mintick), but 0.40 on
//      MNQ is $0.80 and would be stopped out by the spread.
//   4. Optional end-of-session flatten. Equities are flattened server-side by
//      the Kairos EOD scheduler; there is no futures path there, and an open
//      futures position carries overnight on margin.
//
// SUGGESTED RISK DEFAULTS (points):
//      MNQ / NQ   loss 20    trigger 10    offset 5
//      MES / ES   loss  5    trigger 2.5   offset 1.5
// CONTRACT VALUES:  ES $50/pt · MES $5/pt · NQ $20/pt · MNQ $2/pt (tick 0.25)
// Start on MES/MNQ — same price action, 1/10th the damage while calibrating.
//
// ALERTS: set the TradingView alert Message box to exactly:
//      {{strategy.order.alert_message}}
// =============================================================================

strategy(
     title                   = 'CAM_BREAKOUT_R3S3_FUT',
     shorttitle              = 'CAM_BR_R3S3_FUT',
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 50000,
     currency                = currency.USD,
     // FUTURES DELTA 1 — see header. Without this, nothing fills.
     margin_long             = 5,
     margin_short            = 5,
     // FUTURES DELTA 2 — see header.
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 2.25,
     slippage                = 1,
     process_orders_on_close = true)

// ═══════════════════════════════════════════════════════════════
// WEBHOOK ROUTING
// ═══════════════════════════════════════════════════════════════
strategyId = input.string('CAM_TICKER_BREAKOUT_R3S3_05MIN', 'Routing Strategy ID',
     group='Webhook',
     tooltip='Must match the routing rule name on the Kairos server, e.g. CAM_MNQ_BREAKOUT_R3S3_05MIN. Update this for every alert you create.')
brokerName = input.string('alpaca-paper', 'Broker',
     options=['alpaca-paper','alpaca-live','ib-paper','ib-live','coinbase'],
     group='Webhook',
     tooltip='NOTE: no broker here trades futures today — Alpaca has no futures and the IB path in Kairos is STK/OPT only. Backtest/paper until that is built.')
qty        = input.int(1, 'Quantity (contracts)', minval=1, group='Webhook')

// ═══════════════════════════════════════════════════════════════
// RISK / EXIT PARAMETERS
// Same mechanism as the equity script: a price distance converted to ticks.
// FUTURES DELTA 3 — defaults scaled to contract, see header table.
// ═══════════════════════════════════════════════════════════════
lossDollars        = input.float(20.0, 'Stop Loss (points)',     step=0.25, group='Risk')
trailPointsDollars = input.float(10.0, 'Trail Trigger (points)', step=0.25, group='Risk')
trailOffsetDollars = input.float(5.0,  'Trail Offset (points)',  step=0.25, group='Risk')
lossTicks        = math.round(lossDollars        / syminfo.mintick)
trailPointsTicks = math.round(trailPointsDollars / syminfo.mintick)
trailOffsetTicks = math.round(trailOffsetDollars / syminfo.mintick)

// ═══════════════════════════════════════════════════════════════
// EMA FILTER
// ═══════════════════════════════════════════════════════════════
emaPeriod    = input.int(8, 'EMA Period', minval=1, group='Filter')
useEmaFilter = input.bool(true, 'EMA Trend Filter (close > EMA for long)', group='Filter')
emaVal = ta.ema(close, emaPeriod)

// ═══════════════════════════════════════════════════════════════
// BREAKOUT TRIGGER STYLE
// ═══════════════════════════════════════════════════════════════
triggerStyle = input.string('Cross', 'Trigger Style',
     options=['Cross','Engulf'],
     group='Breakout Trigger',
     tooltip='Cross = previous close below R3, current close above (true breakout). Engulf = open below R3, close above.')

// ═══════════════════════════════════════════════════════════════
// RTH SESSION — explicit timezone so chart tz setting cannot break it
// ═══════════════════════════════════════════════════════════════
rthSession = input.session('0930-1600', 'RTH Session', group='Session')
inRTH      = not na(time(timeframe.period, rthSession, "America/New_York"))
newRTHDay  = inRTH and not inRTH[1]

// FUTURES DELTA 4 — see header. Equities get flattened by the Kairos EOD
// scheduler server-side; futures have no such path and carry overnight margin.
eodFlat = input.bool(true, 'Flatten at RTH close', group='Session',
     tooltip='Futures-only addition. The equity script relies on the server-side EOD scheduler, which has no futures path.')

// ═══════════════════════════════════════════════════════════════
// CURRENT RTH SESSION OHLC
// ═══════════════════════════════════════════════════════════════
var float curRTHHigh  = na
var float curRTHLow   = na
var float curRTHClose = na

if newRTHDay
    curRTHHigh  := high
    curRTHLow   := low
    curRTHClose := close
else if inRTH
    curRTHHigh  := math.max(nz(curRTHHigh, high), high)
    curRTHLow   := math.min(nz(curRTHLow,  low),  low)
    curRTHClose := close

// ═══════════════════════════════════════════════════════════════
// PREVIOUS RTH SESSION OHLC
// Saved at the moment RTH closes (inRTH → not inRTH transition).
// This is more reliable than reading curRTH*[1] at newRTHDay because
// extended-hours bars between sessions can make that lookback land on
// a non-RTH bar where curRTH* was never written. That failure mode is
// far MORE likely on futures than on equities — there are ~17.5 hours
// of ETH bars between sessions here, not a handful.
// ═══════════════════════════════════════════════════════════════
var float prevRTHHigh  = na
var float prevRTHLow   = na
var float prevRTHClose = na

if inRTH[1] and not inRTH and not na(curRTHHigh)
    prevRTHHigh  := curRTHHigh
    prevRTHLow   := curRTHLow
    prevRTHClose := curRTHClose

// ═══════════════════════════════════════════════════════════════
// CAMARILLA CALCULATIONS
// ═══════════════════════════════════════════════════════════════
H   = prevRTHHigh
L   = prevRTHLow
C   = prevRTHClose
rng = H - L

r1 = na(H) ? na : C + rng * 1.1 / 12
s1 = na(H) ? na : C - rng * 1.1 / 12
r2 = na(H) ? na : C + rng * 1.1 / 6
s2 = na(H) ? na : C - rng * 1.1 / 6
r3 = na(H) ? na : C + rng * 1.1 / 4
s3 = na(H) ? na : C - rng * 1.1 / 4
r4 = na(H) ? na : C + rng * 1.1 / 2
s4 = na(H) ? na : C - rng * 1.1 / 2
r5 = na(H) ? na : r4 + 1.168 * (r4 - r3)
s5 = na(H) ? na : s4 - 1.168 * (s3 - s4)
r6 = na(H) ? na : (H / L) * C
s6 = na(H) ? na : C - (r6 - C)
dp = na(H) ? na : (H + L + C) / 3

// ═══════════════════════════════════════════════════════════════
// ACTIVE BREAKOUT LEVELS — R3 / S3
// ═══════════════════════════════════════════════════════════════
upperLevel = r3
lowerLevel = s3

// ═══════════════════════════════════════════════════════════════
// STRATEGY CONDITIONS
// ═══════════════════════════════════════════════════════════════
longEngulf  = close > upperLevel and open < upperLevel
shortEngulf = close < lowerLevel and open > lowerLevel

longCross   = close > upperLevel and close[1] <= upperLevel
shortCross  = close < lowerLevel and close[1] >= lowerLevel

longTrigger  = triggerStyle == 'Cross' ? longCross  : longEngulf
shortTrigger = triggerStyle == 'Cross' ? shortCross : shortEngulf

emaPassLong  = not useEmaFilter or close > emaVal
emaPassShort = not useEmaFilter or close < emaVal

longCondition  = inRTH and not na(upperLevel) and longTrigger  and emaPassLong
shortCondition = inRTH and not na(lowerLevel) and shortTrigger and emaPassShort

// ═══════════════════════════════════════════════════════════════
// ALERT MESSAGES
// ═══════════════════════════════════════════════════════════════
qtyStr = str.tostring(qty)

longMsg      = '{"ticker":"' + syminfo.ticker + '","action":"LONG","sentiment":"{{strategy.market_position}}","quantity":' + qtyStr + ',"price":"{{close}}","time":"{{timenow}}","strategy":"' + strategyId + '","interval":"{{interval}}","broker":"' + brokerName + '"}'
shortMsg     = '{"ticker":"' + syminfo.ticker + '","action":"SHORT","sentiment":"{{strategy.market_position}}","quantity":' + qtyStr + ',"price":"{{close}}","time":"{{timenow}}","strategy":"' + strategyId + '","interval":"{{interval}}","broker":"' + brokerName + '"}'
exitLongMsg  = '{"ticker":"' + syminfo.ticker + '","action":"EXIT_LONG","sentiment":"{{strategy.market_position}}","quantity":' + qtyStr + ',"price":"{{close}}","time":"{{timenow}}","strategy":"' + strategyId + '","interval":"{{interval}}","broker":"' + brokerName + '"}'
exitShortMsg = '{"ticker":"' + syminfo.ticker + '","action":"EXIT_SHORT","sentiment":"{{strategy.market_position}}","quantity":' + qtyStr + ',"price":"{{close}}","time":"{{timenow}}","strategy":"' + strategyId + '","interval":"{{interval}}","broker":"' + brokerName + '"}'

// ═══════════════════════════════════════════════════════════════
// ENTRIES + EXITS
// ═══════════════════════════════════════════════════════════════
if longCondition and strategy.position_size <= 0
    strategy.entry('Long', strategy.long, qty=qty, alert_message=longMsg)
    strategy.exit('Exit Long', 'Long',
         trail_points  = trailPointsTicks,
         trail_offset  = trailOffsetTicks,
         loss          = lossTicks,
         alert_message = exitLongMsg)

if shortCondition and strategy.position_size >= 0
    strategy.entry('Short', strategy.short, qty=qty, alert_message=shortMsg)
    strategy.exit('Exit Short', 'Short',
         trail_points  = trailPointsTicks,
         trail_offset  = trailOffsetTicks,
         loss          = lossTicks,
         alert_message = exitShortMsg)

// FUTURES DELTA 4 — flatten on the RTH close transition.
if eodFlat and inRTH[1] and not inRTH and strategy.position_size != 0
    if strategy.position_size > 0
        strategy.close('Long',  comment='eod', alert_message=exitLongMsg)
    if strategy.position_size < 0
        strategy.close('Short', comment='eod', alert_message=exitShortMsg)

// ═══════════════════════════════════════════════════════════════
// DISPLAY TOGGLES
// ═══════════════════════════════════════════════════════════════
showEMA     = input.bool(true,  'Show EMA',                   group='Display')
showActive  = input.bool(true,  'Show Active Breakout Levels', group='Display')
labelOffset = input.int(20, 'Right Label Offset', minval=1,    group='Display')

showR1 = input.bool(false, 'Show R1', inline='R1', group='Camarilla Levels')
showR2 = input.bool(false, 'Show R2', inline='R2', group='Camarilla Levels')
showR3 = input.bool(true,  'Show R3', inline='R3', group='Camarilla Levels')
showR4 = input.bool(false, 'Show R4', inline='R4', group='Camarilla Levels')
showR5 = input.bool(false, 'Show R5', inline='R5', group='Camarilla Levels')
showR6 = input.bool(false, 'Show R6', inline='R6', group='Camarilla Levels')
showDP = input.bool(true,  'Show DP', inline='DP', group='Camarilla Levels')
showS1 = input.bool(false, 'Show S1', inline='S1', group='Camarilla Levels')
showS2 = input.bool(false, 'Show S2', inline='S2', group='Camarilla Levels')
showS3 = input.bool(true,  'Show S3', inline='S3', group='Camarilla Levels')
showS4 = input.bool(false, 'Show S4', inline='S4', group='Camarilla Levels')
showS5 = input.bool(false, 'Show S5', inline='S5', group='Camarilla Levels')
showS6 = input.bool(false, 'Show S6', inline='S6', group='Camarilla Levels')

// ═══════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════
plot(showEMA ? emaVal : na, title='EMA', color=color.white, linewidth=2)

colR1S1 = color.new(color.gray,    60)
colR2S2 = color.new(color.gray,    50)
colR3    = color.new(color.red,    30)
colS3    = color.new(color.green,  30)
colR4S4 = color.new(color.red,     40)
colR5S5 = color.new(color.purple,  40)
colR6S6 = color.new(color.fuchsia, 40)
colDP    = color.new(color.aqua,   30)

plot(showR1 ? r1 : na, 'R1', color=colR1S1, style=plot.style_linebr, linewidth=1)
plot(showR2 ? r2 : na, 'R2', color=colR2S2, style=plot.style_linebr, linewidth=1)
plot(showR3 ? r3 : na, 'R3', color=colR3,   style=plot.style_linebr, linewidth=1)
plot(showR4 ? r4 : na, 'R4', color=colR4S4, style=plot.style_linebr, linewidth=1)
plot(showR5 ? r5 : na, 'R5', color=colR5S5, style=plot.style_linebr, linewidth=1)
plot(showR6 ? r6 : na, 'R6', color=colR6S6, style=plot.style_linebr, linewidth=1)
plot(showDP ? dp : na, 'DP', color=colDP,   style=plot.style_linebr, linewidth=1)
plot(showS1 ? s1 : na, 'S1', color=colR1S1, style=plot.style_linebr, linewidth=1)
plot(showS2 ? s2 : na, 'S2', color=colR2S2, style=plot.style_linebr, linewidth=1)
plot(showS3 ? s3 : na, 'S3', color=colS3,   style=plot.style_linebr, linewidth=1)
plot(showS4 ? s4 : na, 'S4', color=colR4S4, style=plot.style_linebr, linewidth=1)
plot(showS5 ? s5 : na, 'S5', color=colR5S5, style=plot.style_linebr, linewidth=1)
plot(showS6 ? s6 : na, 'S6', color=colR6S6, style=plot.style_linebr, linewidth=1)

plot(showActive ? upperLevel : na, title='Upper Breakout (R3)', color=color.red,   linewidth=2, style=plot.style_stepline)
plot(showActive ? lowerLevel : na, title='Lower Breakout (S3)', color=color.green, linewidth=2, style=plot.style_stepline)

// ═══════════════════════════════════════════════════════════════
// RIGHT-SIDE LABELS
// ═══════════════════════════════════════════════════════════════
var label upperLabel = na
var label lowerLabel = na

if barstate.islast
    label.delete(upperLabel)
    label.delete(lowerLabel)

    if not na(upperLevel)
        upperLabel := label.new(
             bar_index + labelOffset, upperLevel,
             'R3 ' + str.tostring(upperLevel, format.mintick),
             style     = label.style_label_left,
             color     = color.red,
             textcolor = color.white)

    if not na(lowerLevel)
        lowerLabel := label.new(
             bar_index + labelOffset, lowerLevel,
             'S3 ' + str.tostring(lowerLevel, format.mintick),
             style     = label.style_label_left,
             color     = color.green,
             textcolor = color.white)
