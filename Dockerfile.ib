FROM ghcr.io/gnzsnz/ib-gateway:stable

USER root

# Auto-accept incoming API connections (suppresses the write-access confirmation dialog)
RUN grep -q "^AcceptIncomingConnectionAction=" /home/ibgateway/ibc/config.ini \
    && sed -i 's/^AcceptIncomingConnectionAction=.*/AcceptIncomingConnectionAction=accept/' /home/ibgateway/ibc/config.ini \
    || echo "AcceptIncomingConnectionAction=accept" >> /home/ibgateway/ibc/config.ini

# Take over as primary session if another IB session is already active
# (prevents Gateway from shutting itself down when TWS/mobile is also logged in)
RUN grep -q "^ExistingSessionDetectedAction=" /home/ibgateway/ibc/config.ini \
    && sed -i 's/^ExistingSessionDetectedAction=.*/ExistingSessionDetectedAction=primaryoverride/' /home/ibgateway/ibc/config.ini \
    || echo "ExistingSessionDetectedAction=primaryoverride" >> /home/ibgateway/ibc/config.ini

# Disable Read-Only API mode in IBC config
RUN grep -q "^ReadOnlyApi=" /home/ibgateway/ibc/config.ini \
    && sed -i 's/^ReadOnlyApi=.*/ReadOnlyApi=no/' /home/ibgateway/ibc/config.ini \
    || echo "ReadOnlyApi=no" >> /home/ibgateway/ibc/config.ini

# Patch IBC config.ini so it writes TrustedIPs=* into jts.ini instead of 127.0.0.1
RUN grep -q "^TrustedTwsApiClientIPs=" /home/ibgateway/ibc/config.ini \
    && sed -i 's/^TrustedTwsApiClientIPs=.*/TrustedTwsApiClientIPs=*/' /home/ibgateway/ibc/config.ini \
    || echo "TrustedTwsApiClientIPs=*" >> /home/ibgateway/ibc/config.ini

# Pre-write jts.ini with TrustedIPs=* and read-write API enabled
RUN mkdir -p /home/ibgateway/Jts && \
    printf '[Logon]\nLocale=en\nUseSSL=true\n\n[IBGateway]\nApiOnly=true\nTrustedIPs=*\nReadOnlyApi=false\n' \
    > /home/ibgateway/Jts/jts.ini

USER ibgateway
